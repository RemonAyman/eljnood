rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 🛡️ 1. دالة التحقق من تسجيل الدخول والمصادقة الموثوقة للتطبيق
    function isAuthenticated() {
      return request.auth != null;
    }

    // 🛡️ 2. جلب بيانات رتبة المستخدم بأمان بدون أخطاء Runtime
    function getUserData() {
      return request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};
    }

    // 🛡️ 3. التحقق من صلاحيات الأدمن والقيادة العليا
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token != null && request.auth.token.role == 'ADMIN') || 
        (getUserData().role == 'ADMIN')
      );
    }

    // 🛡️ 4. التحقق من صلاحيات القادة ورؤساء القطاعات
    function isLeaderOrAdmin() {
      return isAuthenticated() && (
        (request.auth.token != null && request.auth.token.role in ['ADMIN', 'LEADER', 'SECTION_LEADER', 'GROUP_MANAGER', 'JOWALAH']) ||
        (getUserData().role in ['ADMIN', 'LEADER', 'SECTION_LEADER', 'GROUP_MANAGER', 'JOWALAH'])
      );
    }

    // 🛡️ 5. التحقق من ملكية الحساب الشخصي
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ─── 1. Members Collection (بيانات الكشافة وقيد الأعضاء) ───
    match /members/{memberId} {
      allow read: if isAuthenticated();
      allow create, update: if isLeaderOrAdmin();
      allow delete: if isAdmin();
    }

    // ─── 2. Attendance Records (سجلات الحضور والغياب والباركود) ───
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated();
      allow create, update: if isLeaderOrAdmin();
      allow delete: if isAdmin();
    }

    // ─── 3. Financial Subscriptions (الاشتراكات المالية والإيصالات والخزينة) ───
    match /subscriptions/{subId} {
      allow read: if isAuthenticated();
      allow create, update: if isLeaderOrAdmin();
      allow delete: if isAdmin();
    }

    // ─── 4. Follow-up & Excuses (الافتقاد والرعاية وأعذار الغياب) ───
    match /followups/{followupId} {
      allow read, write: if isLeaderOrAdmin();
    }
    match /follow_ups/{followId} {
      allow read, write: if isLeaderOrAdmin();
    }
    match /absence_excuses/{excuseId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isLeaderOrAdmin();
    }

    // ─── 5. Curricula (المناهج والمسابقات الكشفية والروحية) ───
    match /curricula/{curriculumId} {
      allow read: if isAuthenticated();
      allow write: if isLeaderOrAdmin();
    }

    // ─── 6. Memories & Photo Gallery (معرض الصور وأرشيف المعسكرات) ───
    match /memories/{memoryId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isLeaderOrAdmin();
    }

    // ─── 7. Users Collection (حسابات المستخدمين والقادة وأولياء الأمور) ───
    match /users/{userId} {
      allow read: if isAuthenticated();
      // السماح للمستخدم بتحديث ملفه الشخصي بشرط عدم تعديل رتبته (role) ما لم يكن أدمن
      allow create: if isAuthenticated() && (
        request.auth.uid == userId || isAdmin()
      );
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])))
      );
      allow delete: if isAdmin();
    }

    // ─── 8. Chat Rooms & Messages (غرف الدردشة والمراسلات الفورية) ───
    match /chat_rooms/{roomId} {
      allow read, write: if isAuthenticated();
      
      match /messages/{msgId} {
        allow read, create: if isAuthenticated();
        allow update, delete: if isLeaderOrAdmin() || (isAuthenticated() && resource.data.senderId == request.auth.uid);
      }
    }
    match /chat_messages/{msgId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isLeaderOrAdmin() || (isAuthenticated() && resource.data.senderId == request.auth.uid);
    }

    // ─── 9. Scouting Events (الفعاليات والحفلات والمعسكرات) ───
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isLeaderOrAdmin();
    }
    match /parties_events/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isLeaderOrAdmin();
    }

    // ─── 10. Scouting Plans (الخطط السنوية الكشفية) ───
    match /scouting_plans/{planId} {
      allow read: if isAuthenticated();
      allow write: if isLeaderOrAdmin();
    }

    // ─── 11. Room Reservations & Inventory (قاعات الكنيسة والمهمات) ───
    match /room_reservations/{resId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isLeaderOrAdmin() || (isAuthenticated() && resource.data.requesterId == request.auth.uid);
    }
    match /inventory_requests/{reqId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isLeaderOrAdmin() || (isAuthenticated() && resource.data.requesterId == request.auth.uid);
    }

    // ─── 12. Discount Codes (أكواد وخصومات الاشتراكات المالية) ───
    match /discount_codes/{codeId} {
      allow read: if isAuthenticated();
      allow write: if isLeaderOrAdmin();
    }

    // ─── 13. OTP Verification Logs (سجلات التحقق والأمان من الهاتف) ───
    match /otp_verifications/{otpId} {
      allow read, write: if isAuthenticated() || isLeaderOrAdmin();
    }

    // ─── 14. Urgent Notifications (التنبيهات والإشعارات العامة) ───
    match /notifications/{notifId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isLeaderOrAdmin();
    }

    // ─── 15. Push Notification Device Tokens (توكن إشعارات النظام للأجهزة والمستخدمين) ───
    match /push_tokens/{tokenId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ─── 16. System Logs & Audits (سجلات النظام والأمان) ───
    match /system_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // السجلات غير قابلة للتعديل أو الحذف لضمان نزاهتها
    }

    // ─── 17. Subscription Settings (أسعار واشتراكات القطاعات والمراحل) ───
    match /subscription_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isLeaderOrAdmin();
    }

    // ─── 18. Default Deny Fallback (منع أي وصول غير محدد صراحة) ───
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
