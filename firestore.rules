rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1️⃣ سجل وبيانات الأعضاء الكشفية (استعلام، إضافة، وتعديل)
    match /members/{memberId} {
      allow read, write: if true;
    }

    // 2️⃣ سجلات الحضور والانضباط وطابور الصباح بالـ QR
    match /attendance/{attendanceId} {
      allow read, write: if true;
    }

    // 3️⃣ سجل الاشتراكات المالية والإيصالات وأكواد الخصم
    match /subscriptions/{subscriptionId} {
      allow read, write: if true;
    }

    // 4️⃣ حسابات المستخدمين (قادة، أولياء أمور، كشافة، مسؤولين)
    match /users/{userId} {
      allow read, write: if true;
    }

    // 5️⃣ أرشيف الذكريات وألبومات الصور والمعسكرات الكشفية
    match /memories/{memoryId} {
      allow read, write: if true;
    }

    // 6️⃣ المناهج الكشفية والأوسمة والمسابقات
    match /curricula/{curriculumId} {
      allow read, write: if true;
    }

    // 7️⃣ الآية اليومية، الطقس الكنسي، والرسائل الروحية
    match /bible_daily/{bibleId} {
      allow read, write: if true;
    }

    // 8️⃣ غرف المحادثات والشات المباشر والرسائل بين القادة والأعضاء
    match /chat_messages/{messageId} {
      allow read, write: if true;
    }
    match /chats/{chatId} {
      allow read, write: if true;
    }

    // 9️⃣ إدارة واستعارة العهدة والمهمات الكشفية
    match /inventory_requests/{requestId} {
      allow read, write: if true;
    }
    match /inventory/{itemId} {
      allow read, write: if true;
    }

    // 🔟 جدول حجز قاعات ومسارح الكنيسة
    match /room_reservations/{reservationId} {
      allow read, write: if true;
    }

    // 1️⃣1️⃣ الخطة والجدول السنوي الكشفي
    match /scouting_plans/{planId} {
      allow read, write: if true;
    }

    // 1️⃣2️⃣ إعدادات النظام وجدول أسعار الاشتراكات الديناميكية
    match /app_settings/{settingId} {
      allow read, write: if true;
    }

    // 1️⃣3️⃣ الإشعارات والتنبيهات المركزية
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // 🌐 السماح الشامل لأي مستندات أو مجموعات فرعية إضافية
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
