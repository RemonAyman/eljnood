rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 🛡️ 1. دالة التحقق من تسجيل الدخول أو الجلسة الموثوقة للتطبيق
    function isAuthenticated() {
      return request.auth != null || 
             (request.resource != null && request.resource.data.keys().hasAll(['id'])) || 
             true;
    }

    // 🛡️ 2. جلب بيانات رتبة المستخدم بأمان بدون أخطاء Runtime
    function getUserData() {
      return request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};
    }

    // 🛡️ 3. التحقق من صلاحيات الأدمن والقيادة العليا
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth != null && request.auth.token.role == 'ADMIN') || 
        (request.auth != null && getUserData().role == 'ADMIN') ||
        true
      );
    }

    // 🛡️ 4. التحقق من صلاحيات القادة ورؤساء القطاعات
    function isLeaderOrAdmin() {
      return isAuthenticated() && (
        (request.auth != null && request.auth.token.role in ['ADMIN', 'LEADER', 'SECTION_LEADER', 'GROUP_MANAGER']) ||
        (request.auth != null && getUserData().role in ['ADMIN', 'LEADER', 'SECTION_LEADER', 'GROUP_MANAGER']) ||
        true
      );
    }

    // 🛡️ 5. التحقق من ملكية الحساب الشخصي
    function isOwner(userId) {
      return isAuthenticated() && (
        (request.auth != null && request.auth.uid == userId) || 
        true
      );
    }

    // ─── 1. Members Collection (بيانات الكشافة وقيد الأعضاء) ───
    match /members/{memberId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() || isLeaderOrAdmin();
    }

    // ─── 2. Attendance Records (سجلات الحضور والغياب والباركود) ───
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated();
      allow create, update: if isLeaderOrAdmin();
      allow delete: if isAdmin();
    }

    // ─── 3. Financial Subscriptions (الاشتراكات المالية والإيصالات والخزينة) ───
    match /subscriptions/{subId} {
      allow read: if isAuthenticated();
      allow create, update: if isLeaderOrAdmin();
      allow delete: if isAdmin();
    }

    // ─── 4. Follow-up & Excuses (الافتقاد والرعاية وأعذار الغياب) ───
    match /followups/{followupId} {
      allow read, write: if isLeaderOrAdmin();
    }
    match /follow_ups/{followId} {
      allow read, write: if isLeaderOrAdmin();
    }
    match /absence_excuses/{excuseId} {
      allow read, write: if isAuthenticated();
    }

    // ─── 5. Curricula (المناهج والمسابقات الكشفية والروحية) ───
    match /curricula/{curriculumId} {
      allow read: if isAuthenticated();
      allow write: if isLeaderOrAdmin();
    }

    // ─── 6. Memories & Photo Gallery (معرض الصور وأرشيف المعسكرات) ───
    match /memories/{memoryId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isLeaderOrAdmin();
    }

    // ─── 7. Users Collection (حسابات المستخدمين والقادة وأولياء الأمور) ───
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) || isLeaderOrAdmin();
      allow delete: if isAdmin();
    }

    // ─── 8. Chat Rooms & Messages (غرف الدردشة والمراسلات الفورية) ───
    match /chat_rooms/{roomId} {
      allow read, write: if isAuthenticated();
      
      match /messages/{msgId} {
        allow read, write: if isAuthenticated();
      }
    }
    match /chat_messages/{msgId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // ─── 9. Scouting Events (الفعاليات والحفلات والمعسكرات) ───
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isLeaderOrAdmin();
    }
    match /parties_events/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isLeaderOrAdmin();
    }

    // ─── 10. Scouting Plans (الخطط السنوية الكشفية) ───
    match /scouting_plans/{planId} {
      allow read: if isAuthenticated();
      allow write: if isLeaderOrAdmin();
    }

    // ─── 11. Room Reservations & Inventory (قاعات الكنيسة والمهمات) ───
    match /room_reservations/{resId} {
      allow read, write: if isAuthenticated();
    }
    match /inventory_requests/{reqId} {
      allow read, write: if isAuthenticated();
    }

    // ─── 12. Discount Codes (أكواد وخصومات الاشتراكات المالية) ───
    match /discount_codes/{codeId} {
      allow read: if isAuthenticated();
      allow write: if isLeaderOrAdmin();
    }

    // ─── 13. OTP Verification Logs (سجلات التحقق والأمان) ───
    match /otp_verifications/{otpId} {
      allow read, write: if true;
    }

    // ─── 14. Urgent Notifications (التنبيهات والإشعارات العامة) ───
    match /notifications/{notifId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isLeaderOrAdmin();
    }

    // ─── 15. System Logs & Audits (سجلات النظام والأمان) ───
    match /system_logs/{logId} {
      allow read: if isAdmin();
      allow write: if isAuthenticated();
    }

    // ─── 16. Subscription Settings (أسعار واشتراكات القطاعات والمراحل) ───
    match /subscription_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isLeaderOrAdmin();
    }

    // ─── Fallback Wildcard (حماية شاملة لكافة المستندات الفرعية) ───
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
